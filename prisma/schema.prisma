

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// ENUMS
// =============================================================

enum Role {
  ADMIN
  MENTOR
  MENTEE
}

enum MentorStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SUSPENDED
}



enum ProficiencyLevel {
  NATIVE
  FLUENT
  CONVERSATIONAL
  BASIC
}

enum SkillStatus {
  ACTIVE
  PENDING_REVIEW
  REJECTED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FREELANCE
  INTERNSHIP
  CONTRACT
}

enum AchievementType {
  AWARD
  CERTIFICATION
  COMPETITION
  PUBLICATION
  SPEAKING
  HACKATHON_WIN
  SCHOLARSHIP
  WORK_RECOGNITION
  OTHER
}

// =============================================================
// USER
// Base identity table. All roles (Mentor, Admin, Mentee) extend
// from here using the shared PK pattern.
// =============================================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  password        String?
  phoneNumber     String?
  profileImageKey String?
  authProviderId  String?   // Unique ID from OAuth provider e.g. "LINKEDIN_123"
  role            Role      @default(MENTEE)
  isVerified      Boolean   @default(false)
  isBlocked       Boolean   @default(false)
  timezone        String?    @default("UTC")
  deletedAt       DateTime? // Null = active. Not-null = soft deleted. Email masked on deletion.
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mentor Mentor?

  @@index([role])
  // @@index([deletedAt])
  // @@index([isBlocked])
  @@map("users")
}

// =============================================================
// MENTOR
// Extends User via shared PK. userId IS the PK — no separate id.
// One-to-one with User enforced at the DB level.
// =============================================================

model Mentor {
  userId String       @id // Shared PK — same value as User.id
  user   User         @relation(fields: [userId], references: [id])

  headline   String?
  shortBio   String?
  domainId   String?
  isVerified Boolean      @default(false)
  status     MentorStatus @default(DRAFT)

  // Stripe
  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)

  // Denormalized cache columns — ONLY update via MentorService, never raw writes
  averageRating Float @default(0)
  reviewCount   Int   @default(0)
  slotDurationMinutes Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  domain               Domain?                     @relation(fields: [domainId], references: [id])
  bookingSettings      MentorBookingSettings?       // One-to-one: mentor has one booking config
  notificationSettings MentorNotificationSettings?  // One-to-one: mentor has one notification config
  socialLinks          SocialLink[]
  mentorLanguages      MentorLanguage[]
  mentorSkills         MentorSkill[]
  experiences          Experience[]
  education            Education[]
  achievements         Achievement[]
  sessions             Session[]
  availability         Availability[]
  @@index([status])
  @@index([domainId])
  // @@index([averageRating])
  @@map("mentors")
}

// =============================================================
// MENTOR BOOKING SETTINGS
// Extracted from Mentor to keep the Mentor table focused.
// Shared PK pattern — userId is both PK and FK.
// =============================================================

model MentorBookingSettings {
  userId String @id
  mentor Mentor @relation(fields: [userId], references: [userId])

  leadTimeHours           Int @default(24) // Min hours before a booking can be made
  futureLimitDays         Int @default(30) // How far ahead mentees can book
  maxSessionsDaily        Int @default(4)  // Max sessions per day
  bufferTimeMinutes       Int @default(15) // Gap between sessions
  cancellationCutoffHours Int @default(24) // Hours before session cancellation is allowed

  updatedAt DateTime @updatedAt

  @@map("mentor_booking_settings")
}

// =============================================================
// MENTOR NOTIFICATION SETTINGS
// Typed columns instead of Json — explicit, queryable, type-safe.
// Shared PK pattern — userId is both PK and FK.
// =============================================================

model MentorNotificationSettings {
  userId String @id
  mentor Mentor @relation(fields: [userId], references: [userId])

  emailOnBooking Boolean @default(true)
  emailOnCancel  Boolean @default(true)
  emailOnReview  Boolean @default(true)
  smsOnBooking   Boolean @default(false)
  smsOnCancel    Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("mentor_notification_settings")
}

// =============================================================
// DOMAINS
// Admin-managed master list of mentoring domains e.g. "Engineering"
// =============================================================

model Domain {
  id         String   @id @default(uuid())
  domainName String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  mentors Mentor[]

  @@map("domains")
}

// =============================================================
// SOCIAL LINKS
// Belongs to Mentor domain — uses mentorId pointing to Mentor.userId.
// One row per platform per mentor enforced by @@unique.
// =============================================================

model SocialLink {
  id       String         @id @default(uuid())
  mentorId String
  mentor   Mentor         @relation(fields: [mentorId], references: [userId])
  platform String
  url      String

  // @@unique([mentorId, platform]) // A mentor can only have one link per platform
  @@index([mentorId])
  @@map("social_links")
}

// =============================================================
// LANGUAGES
// Master list of languages. Mentors link to these via MentorLanguage.
// =============================================================

model Language {
  id   String @id @default(uuid())
  name String @unique
  code String @unique // ISO 639-1 code e.g. "en", "hi", "fr"

  mentorLanguages MentorLanguage[]

  @@map("languages")
}

model MentorLanguage {
  mentorId    String
  languageId  String
  proficiency ProficiencyLevel

  mentor   Mentor   @relation(fields: [mentorId], references: [userId])
  language Language @relation(fields: [languageId], references: [id])

  @@id([mentorId, languageId]) // Composite PK — one row per mentor+language
  @@map("mentor_languages")
}

// =============================================================
// SKILLS
// Admin-managed master list. Mentors link via MentorSkill.
// New skills submitted by mentors start as PENDING_REVIEW.
// =============================================================

model Skill {
  id        String      @id @default(uuid())
  name      String      @unique
  status    SkillStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  mentorSkills MentorSkill[]

  @@map("skills")
}

model MentorSkill {
  mentorId        String
  skillId         String
  yearsExperience Int?

  mentor Mentor @relation(fields: [mentorId], references: [userId])
  skill  Skill  @relation(fields: [skillId], references: [id])

  @@id([mentorId, skillId]) // Composite PK — one row per mentor+skill
  @@map("mentor_skills")
}

// =============================================================
// EXPERIENCE
// Work history entries for a mentor.
// Soft deleted via deletedAt instead of hard delete.
// =============================================================

model Experience {
  id             String         @id @default(uuid())
  mentorId       String
  mentor         Mentor         @relation(fields: [mentorId], references: [userId])

  role           String
  company        String
  employmentType EmploymentType
  startMonth     Int
  startYear      Int
  endMonth       Int?
  endYear        Int?
  isCurrent      Boolean        @default(false)
  description    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  @@index([mentorId])
  // @@index([deletedAt])
  @@map("experiences")
}

// =============================================================
// EDUCATION
// Academic history entries for a mentor.
// Soft deleted via deletedAt instead of hard delete.
// =============================================================

model Education {
  id       String @id @default(uuid())
  mentorId String
  mentor   Mentor @relation(fields: [mentorId], references: [userId])

  institution  String
  degree       String
  fieldOfStudy String
  startMonth   Int
  startYear    Int
  endMonth     Int?
  endYear      Int?
  isCurrent    Boolean @default(false)
  grade        String?
  description  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([mentorId])
  // @@index([deletedAt])
  @@map("education")
}

// =============================================================
// ACHIEVEMENTS
// Awards, certifications, publications etc. for a mentor.
// =============================================================

model Achievement {
  id       String          @id @default(uuid())
  mentorId String
  mentor   Mentor          @relation(fields: [mentorId], references: [userId])

  title    String?
  type     AchievementType
  year     Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([mentorId])
  @@map("achievements")
}


model Session {
  id          String   @id @default(uuid())
  name        String
  price       Int
  mentorId    String
  duration    Int      // in minutes
  description String
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

 mentor   Mentor   @relation(fields: [mentorId], references: [userId])
 @@index([mentorId,price])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Availability {
  id          String    @id @default(uuid())
  mentor   Mentor   @relation(fields: [mentorId], references: [userId])
  mentorId    String
  dayOfWeek   DayOfWeek
  startTime   Int       // minutes since midnight
  endTime     Int       // minutes since midnight
  // validFrom   DateTime?
  // validUntil  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  @@index([mentorId])
}

model AvailabilityException {
  id         String   @id @default(uuid())
  mentorId   String
  date       DateTime
}