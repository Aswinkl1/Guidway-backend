//   @@map("mentor_embeddings")
// }

enum MentorStatus {
  DRAFT            // Currently in the onboarding wizard
  PENDING_REVIEW   // Finished onboarding, waiting for admin approval
  ACTIVE           // Live on the marketplace
  PAUSED           // Temporarily hidden by the mentor (e.g., vacation)
  SUSPENDED        // Locked by an admin for violations
}
model Mentor {
  id                        String   @id @default(uuid())
  userId                    String   @unique // @unique enforces the one-to-one with User
  user                      User     @relation(fields: [userId], references: [id])

  headline                  String?
  shortBio                  String?
  domainId                  String?


  isVerified                Boolean  @default(false)
  status                    MentorStatus @default(DRAFT)
  onboardingStep            Int          @default(1)

  // Stripe
  stripeAccountId           String?
  stripeOnboardingComplete  Boolean  @default(false)

  // AI

  // Cache columns
  averageRating             Decimal  @default(0.00) @db.Decimal(3, 2)
  reviewCount               Int      @default(0)

  // Booking settings
  bookingLeadTimeHours      Int      @default(24)
  bookingFutureLimitDays    Int      @default(30)
  maxSessionsDaily          Int      @default(4)
  bufferTimeMinutes         Int      @default(15)

  cancellationCutoffHours   Int      @default(24)

  // Notifications
  notificationSettings      Json?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt         // <-- added
// Back-relations
  domain          Domain?          @relation(fields: [domainId], references: [id])
  socialLinks     SocialLink[]
  mentorLanguages MentorLanguage[]
  mentorSkills    MentorSkill[]
  experiences     Experience[]
  education       Education[]
  achievements    Achievement[]
  // embedding  MentorEmbedding?

  @@map("mentors")
}


// ==========================================
// DOMAINS
// ==========================================

model Domain {
  id         String   @id @default(uuid())
  domainName String  @unique

  mentors    Mentor[]

  @@map("domains")
}

// ==========================================
// SOCIAL LINKS
// ==========================================

enum SocialPlatform {
  linkedin
  github
  twitter
  instagram
  facebook
  website
  behance
  dribbble
  youtube
  other
}

model SocialLink {
  id         String         @id @default(uuid())
  mentorId   String
  mentor     Mentor         @relation(fields: [mentorId], references: [id])
  platform   SocialPlatform
  url        String

  @@unique([mentorId, platform])
  @@map("social_links")
}

// ==========================================
// LANGUAGES
// ==========================================

model Language {
  id              String           @id @default(uuid())
  name            String
  code            String

  mentorLanguages MentorLanguage[]

  @@map("languages")
}

model MentorLanguage {
  mentorId    String
  languageId  String
  proficiency ProficiencyLevel // Native, Fluent, Conversational

  mentor      Mentor   @relation(fields: [mentorId], references: [id])
  language    Language @relation(fields: [languageId], references: [id])

  @@id([mentorId, languageId])
  @@map("mentor_languages")
}

enum ProficiencyLevel {
  native
  fluent
  conversational
  basic
}
// ==========================================
// SKILLS
// ==========================================

enum SkillStatus {
  active
  pending_review
  rejected
}

model Skill {
  id           String        @id @default(uuid())
  name         String        @unique
  status       SkillStatus   @default(active)

  mentorSkills MentorSkill[]

  @@map("skills")
}

model MentorSkill {
  mentorId        String
  skillId         String
  yearsExperience Int?

  mentor          Mentor @relation(fields: [mentorId], references: [id])
  skill           Skill  @relation(fields: [skillId], references: [id])

  @@id([mentorId, skillId])
  @@map("mentor_skills")
}

// ==========================================
// EXPERIENCE, EDUCATION & ACHIEVEMENTS
// ==========================================

model Experience {
  id          String    @id @default(uuid())
  mentorId    String
  mentor      Mentor    @relation(fields: [mentorId], references: [id])
  role        String?
  company     String?
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date // NULL if currently working
  isCurrent   Boolean   @default(false)
  description String?

  @@map("experiences")
}

model Education {
  id          String    @id @default(uuid())
  mentorId    String
  mentor      Mentor    @relation(fields: [mentorId], references: [id])
  school      String?
  degree      String?
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  grade       String?
  description String?

  @@map("education")
}

enum AchievementType {
  award
  certification
  competition
  publication
  speaking
  hackathon_win
  scholarship
  work_recognition
  other
}

model Achievement {
  id       String          @id @default(uuid())
  mentorId String
  mentor   Mentor          @relation(fields: [mentorId], references: [id])
  title    String?
  type     AchievementType
  year     Int?

  @@map("achievements")
}


