{
  "compilerOptions": {
    "target": "ES2020",

    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "moduleResolution": "Node"
  },
  "include": ["src", "prisma.config.ts"],
  "exclude": ["node_modules"]
}
